<UserControl x:Class="BLDC_Demo.LeftMdrControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:BLDC_Demo.Models"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- SET button enabled/disabled through the SetButtonsEnabled property -->
        <Style x:Key="LockableSetButton"
  TargetType="Button"
  BasedOn="{StaticResource SetButton}">

            <Setter Property="IsEnabled"
       Value="{Binding SetButtonsEnabled,
               RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <!-- Button Border -->
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>

            <!-- Shadow -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
           Color="#5A6A8A"
           BlurRadius="14"
           ShadowDepth="0"
           Opacity="0.30"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <!-- Disabled -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Effect" Value="{x:Null}"/>
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="BorderBrush" Value="#999999"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- Dropdown list item text colour -->
        <Style x:Key="MutedComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#5A6A8A"/>
        </Style>

        <!-- EDIT switch (same look as the ZPA panel) -->
        <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="38" Height="20" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BlueBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#0D47A1"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- IsEnabled="False" REMOVED so ComboBoxes / TextBoxes stay usable -->
    <Border x:Name="RootBorder" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="24,20" Height="510">
        <StackPanel>

            <Grid Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Background="#E3F0FB" BorderBrush="{StaticResource BlueBrush}" BorderThickness="1"
                            CornerRadius="20" Padding="10,3" Margin="0,0,12,0">
                        <TextBlock Text="MDR-L" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource BlueBrush}"/>
                    </Border>
                    <TextBlock Text="LEFT MDR"
                               FontFamily="Arial Black" FontSize="11" FontWeight="Black"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- EDIT: the settings below are locked until this is switched on -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Path Width="11" Height="11" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"
                          Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z M20.71,7.04c0.39-0.39,0.39-1.02,0-1.41l-2.34-2.34c-0.39-0.39-1.02-0.39-1.41,0l-1.83,1.83l3.75,3.75L20.71,7.04z"/>
                    <TextBlock Text="EDIT" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton x:Name="LeftEditToggle"
                                  IsChecked="False"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ModernToggleSwitch}"
                                  Click="LeftEditToggle_Click"
                                  ToolTip="Toggle Edit Mode to modify Left MDR settings"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="LeftFieldsGrid" Margin="0,0,0,0" IsEnabled="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>

                <!-- MOTOR TYPE -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="▸ MOTOR TYPE" Style="{StaticResource FieldLabel}" Foreground="#5A6A8A"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LeftMotorCombo" Foreground="#5A6A8A"
                                  Grid.Column="0"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource MutedComboItem}"/>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetLeftMotorType_Click">

                        </Button>
                    </Grid>
                </StackPanel>

                <!-- BRAKE METHOD -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="▸ BRAKE METHOD" Style="{StaticResource FieldLabel}" Foreground="#5A6A8A"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LeftBrakeCombo" Foreground="#5A6A8A"
                                  Grid.Column="0"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource MutedComboItem}"/>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetLeftBrake_Click">

                        </Button>
                    </Grid>
                </StackPanel>

                <!-- SPEED (range added to the label) -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="▸ SPEED % (0-100)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LeftSpeedTextBox" Foreground="#5A6A8A" Grid.Column="0"
                                 Style="{StaticResource DarkTextBox}" IsReadOnly="False"/>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetSpeed_Click">

                        </Button>
                    </Grid>
                </StackPanel>

                <!-- CURRENT -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="▸ CURRENT (mA)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="LeftCurrentTextBox" Foreground="#5A6A8A" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

                <!-- ACCELERATION -->
                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="▸ ACCELERATION ms(10-10000)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LeftAccelTextBox" Foreground="#5A6A8A" Grid.Column="0"
                                 Style="{StaticResource DarkTextBox}" IsReadOnly="False"/>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetAccel_Click">

                        </Button>
                    </Grid>
                </StackPanel>

                <!-- DECELERATION -->
                <StackPanel Grid.Row="4" Grid.Column="2">
                    <TextBlock Text="▸ DECELERATION ms(10-10000)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LeftDecelTextBox" Foreground="#5A6A8A" Grid.Column="0"
                                 Style="{StaticResource DarkTextBox}" IsReadOnly="False"/>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetDecel_Click">

                        </Button>
                    </Grid>
                </StackPanel>

                <!-- DIRECTION -->
                <StackPanel Grid.Row="6" Grid.Column="0">
                    <TextBlock Text="▸ DIRECTION" Style="{StaticResource FieldLabel}" Foreground="#5A6A8A"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="LeftDirectionCombo" Foreground="#5A6A8A"
                                  Grid.Column="0"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource MutedComboItem}">
                            <ComboBoxItem Content="Clockwise"/>
                            <ComboBoxItem Content="Anticlockwise"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetLeftDirection_Click">

                        </Button>
                    </Grid>
                </StackPanel>

            </Grid>

            <Border Height="1" Background="WhiteSmoke" Margin="0,0,0,15"/>

            <!-- ERROR FLAGS -->
            <Border Background="WhiteSmoke" BorderBrush="#D0D5E0" BorderThickness="1"
                    CornerRadius="8" Padding="16,14" Margin="0,0,0,20" Height="130">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="ERROR FLAGS" FontWeight="Bold" FontFamily="Consolas"
                                   FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="FlagHallSensor" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding LeftHallSensorError}" Width="9" Height="9" StrokeThickness="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Hall Sensor " FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="FlagOverCurrent" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding LeftOverCurrent}" Width="9" Height="9" StrokeThickness="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Over Current" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="FlagOverVoltage" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding LeftOverVoltage}" Width="9" Height="9" StrokeThickness="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Over Voltage (&gt;30V)" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <!-- CHANGED: LeftUnderVoltage -> LeftLowVoltage (the property BL actually sets) -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="FlagLowVoltage" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding LeftLowVoltage}" Width="9" Height="9" StrokeThickness="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Low Voltage (&lt;18V)" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <!-- CHANGED: LeftMotorStalled -> LeftSensor1 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="Flagleftsensor1" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding LeftSensor1}" Width="9" Height="9" StrokeThickness="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Left sensor 1" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                        <!-- CHANGED: LeftOverTemperature -> LeftSensor2 -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="Flagleftsensor2" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding LeftSensor2}" Width="9" Height="9" StrokeThickness="1" Margin="0,0,8,0"/>
                            <TextBlock Text="Left sensor 2" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- RUN button (not affected by SetButtonsEnabled) -->
            <Button x:Name="TripleStateButton" Content="▶  RUN  " HorizontalAlignment="Stretch" Width="82" Height="30"
                    Style="{StaticResource LockableSetButton}" Click="TripleStateButton_Click">

            </Button>
        </StackPanel>
    </Border>
</UserControl>
